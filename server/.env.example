PORT=3000
DATABASE_PATH=
SCREENSHOT_DIR=
DASHSCOPE_API_KEY=
# Vision model used for screenshot reading.
QWEN_MODEL=qwen-vl-max
# Text model used for resolution and insights when DEEPSEEK_API_KEY is empty.
QWEN_TEXT_MODEL=qwen-plus
# Optional: when empty, text tasks fall back to DashScope Qwen.
DEEPSEEK_API_KEY=
# Used only when DEEPSEEK_API_KEY is configured.
DEEPSEEK_MODEL=deepseek-v4-flash
